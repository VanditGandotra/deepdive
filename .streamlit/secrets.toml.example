# Paste these into the Streamlit Cloud secrets box (App settings → Secrets).
# All values become environment variables that config.py reads via os.getenv().

# ── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY = "sk-ant-..."          # Claude API — required for every tab
API_NINJAS_KEY = "..."                    # Earnings call transcripts — required for Earnings tab

# ── Optional ──────────────────────────────────────────────────────────────────
NEWSAPI_KEY = "..."                       # Supplements yfinance news; app works without it
EDGAR_USER_AGENT = "Your Name your@email.com"  # SEC contact header; has a safe default

# ── Budget & limits (optional overrides) ──────────────────────────────────────
# DEEPDIVE_SESSION_BUDGET_USD = "5.0"    # Max $ per session; default 5.0
# DEEPDIVE_DB_PATH = "cache.db"          # SQLite cache path; default cache.db at repo root
